{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["biometricdemo", "handlandmarks"],
  "android": {
    "androidNamespace": ["biometricdemo", "handlandmarks"],
    "androidCxxLibName": "HandLandmarks"
  },
  "autolinking": {
    "HandLandmarks": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridHandLandmarks"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
